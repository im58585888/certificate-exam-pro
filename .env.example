# Copy to .env.local for local development. Everything is optional locally:
# without DATABASE_URL an embedded Postgres (PGlite) is used under .data/, checkout is simulated,
# emails are printed to the server console, and the Google button is hidden.

# ---- Required in production ----
# Public base URL, used for links in emails, OAuth redirects, Stripe redirects and SEO.
APP_URL=https://www.example.com
# Postgres connection string (Neon, Supabase, Amazon RDS, ...). Add ?sslmode=require if your host needs it.
DATABASE_URL=
# Long random string used to hash IP addresses for abuse limits (generate: openssl rand -hex 32).
AUTH_SECRET=

# ---- Payments (Stripe) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Email (password reset) — any SMTP provider: Amazon SES, Resend, Postmark, SendGrid ----
SMTP_URL=smtps://USERNAME:PASSWORD@email-smtp.us-east-1.amazonaws.com:465
MAIL_FROM=Certificate Exam Pro <no-reply@example.com>

# ---- Google sign-in (Google Cloud console → OAuth client, type "Web application") ----
# Authorized redirect URI: <APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Admin console (/admin) — comma-separated emails of accounts allowed in ----
ADMIN_EMAILS=you@example.com

# ---- Tuning (optional) ----
# Free-trial questions allowed per network (hashed IP) per 30 days, across all visitors. Default 40.
TRIAL_NETWORK_CAP=40
